#!/bin/sh
# Git pre-push hook: render the site and run the site checks before anything leaves this machine.
#
# Installed once per clone with:   git config core.hooksPath utils/hooks
# Bypass when you must push anyway: git push --no-verify
#
# Runs only when the commits being pushed touch site/ or utils/ (the same trigger as the
# Publish Site GitHub Action), so pushes of book/ or grading/ work are not slowed down.
# A running `quarto preview` is fine; render and preview coexist (tested with Quarto 1.9).

set -e
cd "$(git rev-parse --show-toplevel)"

touches_site=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        touches_site=1   # new branch: no base to diff against, run the checks
    elif git diff --name-only "$remote_sha" "$local_sha" -- site utils | grep -q .; then
        touches_site=1
    fi
done
[ "$touches_site" = 1 ] || exit 0

echo "pre-push: rendering site and running checks (bypass with: git push --no-verify) ..."
quarto render site --quiet
python3 utils/check_site_links.py
python3 utils/check_schedule_dates.py
echo "pre-push: site checks passed"
