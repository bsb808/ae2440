% Specify the input text file containing the wiki table
inputFile = 'wiki_ships.txt';

% Read the content of the file
fid = fopen(inputFile, 'r');
wikiTable = fread(fid, '*char')';
fclose(fid);

% Initialize cell array for data
data = {};

% Define the regex pattern to extract rows
rowPattern = '\|\-(.*?)\|\-';
rows = regexp(wikiTable, rowPattern, 'tokens');

% Extract header
headerPattern = '!\s*(.+?)\s*';
headers = regexp(wikiTable, headerPattern, 'tokens');
headerRow = strtrim(cellfun(@(x) x{1}, headers, 'UniformOutput', false));

% Process each row
scnt = 0;
for i = 1:length(rows)
    row = rows{i}{1};
    % Extract each column
    columnPattern = '\|\s*(.*?)\s*(?=\|)';
    columns = regexp(row, columnPattern, 'tokens');
    
    % Clean and store columns in the data array
    rowData = cellfun(@(x) strtrim(x{1}), columns, 'UniformOutput', false);
    if size(rowData,2)==20
        data = [data; rowData];  % Append row data
    else
        scnt = scnt+1;
        if length(rowData) > 2
            fprintf("skipping %d: %s\n", scnt, rowData{2});
        end
    end
end

% Clean up the data
hRow = {};
cdata = {};
for ii = 1:size(data,1)
    hrow{1} = "Name";
    cdata{ii,1} = strrep(data{ii,1},'{', '')+" "+data{ii,2};

    hrow{2} = "Hull Number";
    cdata{ii,2} = data{ii,3};

    hrows{3} = "Class";
    cdata{ii,3} = data(ii,8);

    hrows{4} = "Type";
    cdata
end

%% 

% Combine header and data
outputData = [headerRow; data];

% Specify output CSV file
csvFile = 'ships_data.csv';

% Write to CSV file
writecell(outputData, csvFile);

fprintf('CSV file "%s" has been created successfully.\n', csvFile);
